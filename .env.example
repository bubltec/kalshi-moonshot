# demo = Kalshi's play-money environment (default). prod = real money.
KALSHI_ENV=demo
# observe = log decisions only. trade = may place orders (still capped by the risk gate).
MODE=observe
# Real orders need KALSHI_ENV=prod AND this set to true. Leave false until the report shows an edge.
ALLOW_REAL_MONEY=false

# Create keys at https://kalshi.com/account/profile (use demo.kalshi.co for the demo environment).
KALSHI_KEY_ID=
# Host path. Compose mounts ./.secrets at /app/.secrets, and WORKDIR is /app.
KALSHI_PRIVATE_KEY_PATH=./.secrets/kalshi.key

# Hard caps
MAX_USD_PER_TRADE=5
MAX_USD_PER_DAY=20
MAX_OPEN_POSITIONS=8
# Skip a buy when the book has less than this many dollars for sale at our price.
# One contract at 3 cents is a fill, not a position. Raise this toward 1 after testing.
MIN_ORDER_USD=0.25

# The plain market list is almost all sports. Empty this to include every category.
SKIP_CATEGORIES=Sports
# Skip markets that resolve on a number (price, total, count, average). The model cannot see the
# live value, so its odds there are guesses. Set false to include them.
SKIP_NUMERIC=true
# Strategy versions left out of `report` and the similar-case search. Old logic is tagged v1.
# Delete them for good with: docker compose exec bot python -m kalshi_moonshot prune --yes
EXCLUDE_VERSIONS=v1
# Pace Kalshi requests to this many per second so long paging runs do not hit 429s.
# (I have not confirmed Kalshi's exact limit for your account tier; lower it if you still see 429s.)
KALSHI_MAX_RPS=8
# Markets per request. Kalshi accepts 1000 for markets; the event list rejects anything over 200,
# so events stay at 200. 1000 cuts the market-list calls from about 140 to about 28 per scan.
KALSHI_PAGE_SIZE=1000
# Tries per queued job (a market evaluation, a scan) before it is parked as dead. See `jobs`.
JOB_MAX_ATTEMPTS=3
# Hourly scorecard review. It only tightens a setting when a lane or category is clearly
# behind the market, and writes that to data/tuning.json (which overrides .env). Set false to stop.
REVIEW_ENABLED=true
REVIEW_INTERVAL_MINUTES=60
# Skip a long shot whose ask fell this much (a live favorite collapsing is not a moonshot).
MOONSHOT_MAX_DROP=0.02
# Sell (or paper-sell) an open bet when both are true: under this many hours to close, and
# the bid is down this fraction from the price we paid. No bid = cannot exit, so we hold.
STOP_LOSS_ENABLED=true
STOP_LOSS_HOURS=1
STOP_LOSS_DROP=0.30
STOP_LOSS_CHECK_MINUTES=5

# Long-shot filter (prices in dollars; a 0.05 ask pays $1.00, about 20x)
MIN_PRICE=0.02
MAX_PRICE=0.10
MIN_VOLUME=100
MAX_SPREAD=0.03
MIN_HOURS_TO_CLOSE=6
# Hours, not days: 720 is 30 days. Lower it to favor markets that settle soon.
MAX_HOURS_TO_CLOSE=720
MIN_EDGE=0.05

# Local model. Ollama on the Mac host; 16 GB fits qwen3:8b comfortably.
OLLAMA_URL=http://host.docker.internal:11434
MODEL=qwen3:8b
SCAN_INTERVAL_MINUTES=30

# Commodity and crypto lane: the near-decided side of gold, silver, oil, gas, copper and crypto ladders and
# 15-minute markets, bought at 70-98 cents for a small repeating return. YES or NO. See the README.
# Series and feeds live in src/kalshi_moonshot/instruments.toml (copy to DATA_DIR to override).
COMMODITIES_ENABLED=true
# Entry price of the contract bought (the NO price when buying NO).
COMMODITY_MIN_PRICE=0.70
COMMODITY_MAX_PRICE=0.98
COMMODITY_MIN_EDGE=0.015
COMMODITY_MAX_SPREAD=0.04
COMMODITY_MIN_VOLUME=5
# Hours to close. 0.03 is about two minutes.
COMMODITY_MIN_HOURS_TO_CLOSE=0.03
COMMODITY_MAX_HOURS_TO_CLOSE=24
# Scales realized volatility; above 1 allows for fat tails.
COMMODITY_VOL_MULT=1.25
# Never claim a probability closer than this to 0 or 1 (model risk).
COMMODITY_TAIL_FLOOR=0.005
# Width added when the center comes from a remembered feed-to-ladder basis, and how long it stays usable.
COMMODITY_BASIS_UNC=0.0015
COMMODITY_BASIS_AGE_HOURS=6
# Skip an event when the ladder center is this far (fraction) from the feed price: wrong contract.
COMMODITY_MAX_BASIS=0.04
# Refuse a feed whose last price is older than this. Older prices are otherwise widened, not trusted.
COMMODITY_MAX_STALE_MINUTES=20
COMMODITY_USD_PER_TRADE=2
COMMODITY_SHORTLIST=10
# Two loops: scope (slow) finds the ladders worth watching; review (fast) re-prices only those.
COMMODITY_SCOPE_MINUTES=10
COMMODITY_REVIEW_MINUTES=2
# Do not log a new decision for a market this soon after its last one.
COMMODITY_COOLDOWN_MINUTES=15
COMMODITY_WATCH_MAX=40

# Which contracts the moonshot and steady lanes may buy. A cheap NO on a heavy favorite is a long shot too.
# yes, no, or yes,no (default).
MOONSHOT_SIDES=yes,no
STEADY_SIDES=yes,no
