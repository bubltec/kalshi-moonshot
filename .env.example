# demo = Kalshi's play-money environment (default). prod = real money.
KALSHI_ENV=demo
# observe = log decisions only. trade = may place orders (still capped by the risk gate).
MODE=observe
# Real orders need KALSHI_ENV=prod AND this set to true. Leave false until the report shows an edge.
ALLOW_REAL_MONEY=false

# Create keys at https://kalshi.com/account/profile (use demo.kalshi.co for the demo environment).
KALSHI_KEY_ID=
# Host path. Compose mounts ./.secrets at /app/.secrets, and WORKDIR is /app.
KALSHI_PRIVATE_KEY_PATH=./.secrets/kalshi.key

# Hard caps
MAX_USD_PER_TRADE=5
MAX_USD_PER_DAY=20
MAX_OPEN_POSITIONS=8

# The plain market list is almost all sports. Empty this to include every category.
SKIP_CATEGORIES=Sports

# Long-shot filter (prices in dollars; a 0.05 ask pays $1.00, about 20x)
MIN_PRICE=0.02
MAX_PRICE=0.10
MIN_VOLUME=100
MAX_SPREAD=0.03
MIN_HOURS_TO_CLOSE=6
MIN_EDGE=0.05

# Local model. Ollama on the Mac host; 16 GB fits qwen3:8b comfortably.
OLLAMA_URL=http://host.docker.internal:11434
MODEL=qwen3:8b
SCAN_INTERVAL_MINUTES=30
