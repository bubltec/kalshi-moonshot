# demo = Kalshi's play-money environment (default). prod = real money.
KALSHI_ENV=demo
# observe = log decisions only. trade = may place orders (still capped by the risk gate).
MODE=observe
# Real orders need KALSHI_ENV=prod AND this set to true. Leave false until the report shows an edge.
ALLOW_REAL_MONEY=false

# Create keys at https://kalshi.com/account/profile (use demo.kalshi.co for the demo environment).
KALSHI_KEY_ID=
# Host path. Compose mounts ./.secrets at /app/.secrets, and WORKDIR is /app.
KALSHI_PRIVATE_KEY_PATH=./.secrets/kalshi.key
# Polymarket US. The key id is from polymarket.us/developer. The file holds the secret line the
# portal shows once (not a PEM). The bot reads it as the secret. commodity_poly trades there only when named in LIVE_LANES.
POLYMARKET_API_KEY_ID=
POLYMARKET_PRIVATE_KEY_PATH=

# Hard caps
MAX_USD_PER_TRADE=5
# Stop buying for the day once realized losses reach this many dollars (wins offset losses; money spent on open
# positions does not count). The day is New York time. It reads your synced account history, so hand trades count,
# and it is as fresh as the last account sync (ACCOUNT_SYNC_MINUTES). 0 = no limit. The old MAX_USD_PER_DAY still works as this.
MAX_LOSS_PER_DAY=20
MAX_OPEN_POSITIONS=8
# Skip a buy when the book has less than this many dollars for sale at our price.
# One contract at 3 cents is a fill, not a position. Raise this toward 1 after testing.
MIN_ORDER_USD=0.25

# The plain market list is almost all sports. Empty this to include every category.
SKIP_CATEGORIES=Sports
# Skip markets that resolve on a number (price, total, count, average). The model cannot see the
# live value, so its odds there are guesses. Set false to include them.
SKIP_NUMERIC=true
# Strategy versions left out of `report` and the similar-case search. Old logic is tagged v1.
# Delete them for good with: docker compose exec bot python -m kalshi_moonshot prune --yes
EXCLUDE_VERSIONS=v1
# Pace Kalshi requests to this many per second so long paging runs do not hit 429s.
# (I have not confirmed Kalshi's exact limit for your account tier; lower it if you still see 429s.)
KALSHI_MAX_RPS=8
# Markets per request. Kalshi accepts 1000 for markets; the event list rejects anything over 200,
# so events stay at 200. 1000 cuts the market-list calls from about 140 to about 28 per scan.
KALSHI_PAGE_SIZE=1000
# Tries per queued job (a market evaluation, a scan) before it is parked as dead. See `jobs`.
JOB_MAX_ATTEMPTS=3
# Threads that run only buy (evaluate) jobs, apart from scans and reviews. 0 = buys share the main job thread.
BUY_WORKERS=3
# Threads that run only the stop-loss sweep. A scope or review that runs for 20 s used to hold it back for minutes. 0 = it shares the main job thread.
SELL_WORKERS=1
# Hourly scorecard review. It only tightens a setting when a lane or category is clearly
# behind the market, and writes that to data/tuning.json (which overrides .env). Set false to stop.
REVIEW_ENABLED=true
REVIEW_INTERVAL_MINUTES=60
# After that pass, send the last hour of bets to the local model for suggested improvements.
# Written to data/review-notes.md. Never applied. Set false to skip the model call.
REVIEW_LLM=true
# Skip a long shot whose ask fell this much (a live favorite collapsing is not a moonshot).
MOONSHOT_MAX_DROP=0.02
# Sell (or paper-sell) an open bet when both are true: under this many hours to close, and
# the bid is down this fraction from the price we paid. No bid = cannot exit, so we hold.
STOP_LOSS_ENABLED=true
STOP_LOSS_HOURS=1
# The crash exit (every lane that has one, and hand-placed positions) arms once the bet has covered this share of the way from the price paid to $1.00:
# 0.40 = 40% of the distance. Bought at 0.45 it arms at 0.67, at 0.63 at 0.78, at 0.85 at 0.91. A dip before that is mostly noise that recovers (selling there
# lost 11-19 points against holding on the recorded markets). A lane can override it with trail_progress; 0 = that lane's trail_activate (a gain on the
# price paid, MANUAL_EXIT_ACTIVATE for hand-placed bets) instead. The stop-loss is not affected.
CRASH_PROGRESS=0.40
# ... and it sells when this share of the gain (the peak bid over the price paid) has been given back, not on a fixed number of cents: a small dip while
# the bet is still well in profit is not a risk. 0.90 = sell when 90% of the gain is gone. 0 = the fixed drop (trail_drop for a lane, MANUAL_EXIT_DROP by hand).
# A lane can override it with trail_giveback. On the recorded markets this rule cost the least of any exit (about 2 points against holding).
CRASH_GIVEBACK=0.90
# ... and it waits while the live spot price is still comfortably on the winning side of the strike: more than this many sigma, a bid that dipped is noise
# (two BTC/DOGE bets sold at -8% and -10% while spot was still above the strike, then won; the three that lost had spot below it). 0 = off.
# A lane can override it with trail_spot_sigma. Unknown spot means no opinion, so the exit goes ahead. Stops are never held back.
CRASH_SPOT_SIGMA=0.5
STOP_LOSS_DROP=0.50
STOP_LOSS_CHECK_MINUTES=5

# Long-shot filter (prices in dollars; a 0.05 ask pays $1.00, about 20x)
MIN_PRICE=0.02
MAX_PRICE=0.10
MIN_VOLUME=100
MAX_SPREAD=0.03
MIN_HOURS_TO_CLOSE=6
# Hours, not days: 720 is 30 days. Lower it to favor markets that settle soon.
MAX_HOURS_TO_CLOSE=720
MIN_EDGE=0.05

# Local model. Ollama on the Mac host; 16 GB fits qwen3:8b comfortably.
OLLAMA_URL=http://host.docker.internal:11434
MODEL=qwen3:8b
SCAN_INTERVAL_MINUTES=30

# The commodity lane's own settings (price band, spread, edge, return, window, sizing) are in data/strategies.toml [lane.commodity].
# These are the pricing model's parameters, shared by every ladder lane.
# Scales realized volatility; above 1 allows for fat tails.
COMMODITY_VOL_MULT=1.25
# Never claim a probability closer than this to 0 or 1 (model risk).
COMMODITY_TAIL_FLOOR=0.005
# Width added when the center comes from a remembered feed-to-ladder basis, and how long it stays usable.
COMMODITY_BASIS_UNC=0.0015
COMMODITY_BASIS_AGE_HOURS=6
# Skip an event when the ladder center is this far (fraction) from the feed price: wrong contract.
COMMODITY_MAX_BASIS=0.04
# Refuse a feed whose last price is older than this. Older prices are otherwise widened, not trusted.
COMMODITY_MAX_STALE_MINUTES=20

# Which contracts the moonshot and steady lanes may buy. A cheap NO on a heavy favorite is a long shot too.
# yes, no, or yes,no (default).
MOONSHOT_SIDES=yes,no
STEADY_SIDES=yes,no

# --- Sizing: stakes follow the balance (see README). ---
# Paper balance used in observe mode or without credentials; compounds from paper results.
PAPER_BANKROLL_USD=100
# Share of full Kelly to stake. Small = slow, steady growth.
KELLY_FRACTION=0.25
# One bet / all open bets in the lane, as a share of equity (cash plus open bets).
MOONSHOT_BET_PCT=0.01
MOONSHOT_EXPOSURE_PCT=0.15
STEADY_BET_PCT=0.03
STEADY_EXPOSURE_PCT=0.40
# Optional hard dollar ceiling per bet for a lane (0 = sized by balance only). MAX_USD_PER_TRADE still applies.
STEADY_USD_PER_TRADE=0

# Width added when gold's Kraken token price (a proxy for spot) is used with a measured offset.
COMMODITY_PROXY_UNC=0.0010
# Width added when a real-time crypto price alone anchors the center.
COMMODITY_REALTIME_UNC=0.0004

# Which lanes may place real orders when MODE=trade (comma list: moonshot, steady, commodity).
# Unset = every lane. Lanes not named keep paper-trading. "none" = no lane trades.
# commodity also covers crypto and gold. Example: LIVE_LANES=commodity
LIVE_LANES=

# Paper observer: log the side whose exact settlement chance beats its ask in the last 150 s of crypto 15-minute
# markets. Off: the replay edge vanished once fills were delayed. Never places an order.
SETTLEMENT_EDGE_ENABLED=false



# Smallest width allowed for a learned 15-minute offset (ln units); the measured spread is usually smaller.
COMMODITY_WINDOW_UNC_FLOOR=0.00015

# 15-minute windows place real orders only when this is true (MODE=trade and the lane live as well).
# Default false: they paper-trade, so a new short-horizon method is proven on paper before real money.
COMMODITY_15M_LIVE=false

# Keep downloading Kalshi's minute candles for settled 15-minute windows (see `profile`).
HISTORY_ENABLED=true
HISTORY_INTERVAL_MINUTES=60
HISTORY_BATCH=30
HISTORY_KEEP_DAYS=30


# Record Kalshi quotes next to the price they follow (data/tape.db) to measure whether the quote lags. Read-only.
TAPE_ENABLED=true
# Perpetual-futures trade flow (Hyperliquid), one row per coin per second, recorded on the tape beside the Kalshi quotes (see futflow.py).
FUT_FLOW_ENABLED=true
FUT_FLOW_COINS=BTC,ETH,SOL,XRP,DOGE
TAPE_KEEP_DAYS=3

# Does the stop-loss also cover 15-minute windows? History (2,500 windows) says holding them to settlement
# returns about 3 points more than stopping out at -30%. true = today's behavior; false = hold 15-minute windows.
STOP_LOSS_15M=true

# Keep a local copy of your Kalshi fills and settlements (read-only, hourly), including trades made by
# hand in the app, so `mytrades` can analyse your wins and losses next to the bot's.
ACCOUNT_SYNC_ENABLED=true
# Minutes between syncs (at least 5).
ACCOUNT_SYNC_MINUTES=15

# Hours between rewrites of data/patterns.md (what your larger wins and losses have in common; read-only, 0 = off).
PATTERNS_HOURS=6

# Let the bot move cash between your own Kalshi exchanges so a live order is never refused for lack of cash on its exchange
# (the website moves cash around on its own when you trade by hand, which can leave the bot's exchange empty). Off at 0.
# Before a live order, if that market's exchange holds less than the order needs, the bot moves cash in from your richest
# other exchange, up to this many dollars on the exchange, never leaving the source under the KEEP floor, never moving more than
# the daily cap in total (New York day). Every move is logged and kept in the database (table shard_moves).
SHARD_TOPUP_TARGET_USD=0
SHARD_TOPUP_KEEP_USD=25
SHARD_TOPUP_MAX_USD_PER_DAY=50

# More series for the tape to follow (comma list of Kalshi series prefixes), recording quotes, sizes and trade flow so in-play
# behavior can be studied. Example: KXUELGAME,KXUECLGAME,KXCS2GAME,KXDOTA2GAME. Read-only; it grows the tape file.
# Opt-in list of series the tape and discovery follow (plus TAPE_EXTRA_SERIES and every live lane's own series); empty = follow everything.
WATCH_SERIES=
TAPE_EXTRA_SERIES=

# Sell positions you opened by hand in the Kalshi app, from the live socket, to lock in a profit while you are away. Off by default.
# Once a position's bid is MANUAL_EXIT_ACTIVATE over what you paid, it sells when the bid falls MANUAL_EXIT_DROP (dollars) off a peak that
# held a few seconds, or MANUAL_EXIT_FAST at once. It only ever sells for a profit (never at or under cost) and has no stop-loss. Positions
# the bot opened keep their own lane's rules. Real orders also need MODE=trade (and ALLOW_REAL_MONEY=true on prod). See them: `manual`.
# MANUAL_EXIT_SKIP is a comma list of ticker prefixes to leave alone, such as long-held positions (for example SENATE,KXPRES).
MANUAL_EXIT=false
MANUAL_EXIT_SKIP=
MANUAL_EXIT_ACTIVATE=0.10
MANUAL_EXIT_DROP=0.04
MANUAL_EXIT_FAST=0.12
# The least profit worth taking, as a share of what you paid, after the sell fee (0.05 = 5%). Below it the position is held.
MANUAL_EXIT_MIN_PROFIT=0.05
# A stop-loss for those positions too, on the same rules as the bot's: sell when the bid is this fraction under what you paid, a 15-minute market
# only if STOP_LOSS_15M is on, any other market only in its last STOP_LOSS_HOURS. Where the bot can price the market it holds a dip the model still
# rates better than even; elsewhere it sells. 0 = no stop-loss.
MANUAL_EXIT_STOP_LOSS=0.30
# Discovery: one thread lists the open markets of every series any lane uses (every DISCOVERY_SECONDS) and keeps them in a shared cache, with the live quote stream keeping
# prices current. Lanes' scope, review and paper evaluation read that cache (up to DISCOVERY_MAX_AGE / DISCOVERY_EVAL_AGE seconds old) instead of each asking Kalshi, so adding
# a lane adds no requests. A live lane's evaluation always reads the real market before it orders. DISCOVERY_ENABLED=false restores one request per lane per look.
DISCOVERY_ENABLED=true
DISCOVERY_SECONDS=45
DISCOVERY_MAX_AGE=60
DISCOVERY_EVAL_AGE=10
# A hand-placed buy at or under MANUAL_CHEAP_MAX is a moonshot: hold to settlement (no take-profit, no trail, no stop). Set TAKE_X / ARM_X / GIVEBACK only if you want it cashed out.
MANUAL_CHEAP_MAX=0.25
MANUAL_CHEAP_TAKE_X=0
MANUAL_CHEAP_ARM_X=0
MANUAL_CHEAP_GIVEBACK=0
# ... and only once the bid has stayed past that line this many seconds, measured from the bid you could have sold at when it started
# (a buy at the ask starts a spread under its cost, which is not a loss).
MANUAL_EXIT_STOP_CONFIRM=20

# The tape (written all day) lives in a Docker-managed volume at TAPE_DIR, not in the shared ./data folder: a database file written by the
# container and touched from the Mac side is what damaged it once. Nightly consistent copies of both databases go to ./data/backups, and
# `python -m kalshi_moonshot backup` makes one now. Studies read the newest copy: ls -t data/backups/tape-*.db | head -1
BACKUP_KEEP_DAYS=7

# Archive: ship old tape days (and the database backups) to a private S3 bucket made by infra/ (see README, "The archive"). Off while ARCHIVE_BUCKET is empty.
# The AWS keys are for the archiver user the stack creates; create its access key by hand and put the two values here.
ARCHIVE_BUCKET=
ARCHIVE_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Days of tape kept in the local database. Older days that are verified in the bucket may be deleted locally, but only when ARCHIVE_DELETE_LOCAL=true.
# With the archive on, TAPE_KEEP_DAYS no longer deletes anything: only archived days leave. Try it first with:  python -m kalshi_moonshot archive
ARCHIVE_HOT_DAYS=14
ARCHIVE_DELETE_LOCAL=false


# The database. docker-compose.yml points the bot at the bundled Postgres; change the password it is created with here (before the first start).
# POSTGRES_PASSWORD=moonshot

# Sell a hand-placed position that is up and whose market is unstable: the bid is at least MANUAL_EXIT_UNSTABLE_GAIN over what you paid (after fees)
# and has swung MANUAL_EXIT_UNSTABLE_RANGE (dollars, high to low) within MANUAL_EXIT_UNSTABLE_SECONDS. 0 = off, which is how it ships: on past history
# it did no better than holding, so it is being tested forward on a paper lane first.
MANUAL_EXIT_UNSTABLE_GAIN=0
MANUAL_EXIT_UNSTABLE_RANGE=0.06
MANUAL_EXIT_UNSTABLE_SECONDS=20
